import { Outlet, NavLink, useNavigate } from "react-router-dom";
import {
  LayoutDashboard,
  Network,
  Database,
  FileText,
  History,
  Grid2X2,
  Shield,
  Search,
  Bell,
  Settings,
  Plus
} from "lucide-react";

const links = [
  { to: "/overview", label: "Overview", icon: Grid2X2 },
  { to: "/dashboard", label: "Dashboard", icon: LayoutDashboard },
  { to: "/knowledge-graph", label: "Knowledge Graph", icon: Network },
  { to: "/entity-resolution", label: "Entity Resolution", icon: Shield },
  { to: "/data-sources", label: "Data Sources", icon: Database },
  { to: "/audit-trail", label: "Audit Trail", icon: History },
  { to: "/reports", label: "Reports", icon: FileText }
];

export default function Layout() {
  const navigate = useNavigate();

  function logout() {
    localStorage.removeItem("tax_token");
    navigate("/login");
  }

  return (
    <div className="shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brandIcon">▦</div>
          <div>
            <h1>Tax Intel AI</h1>
            <p>Government of Pakistan</p>
          </div>
        </div>

        <nav className="nav">
          {links.map((item) => {
            const Icon = item.icon;
            return (
              <NavLink key={item.to} to={item.to}>
                <Icon size={20} />
                <span>{item.label}</span>
              </NavLink>
            );
          })}
        </nav>

        <button className="newInvestigation" onClick={() => navigate("/entity-resolution")}>
          <Plus size={18} /> New Investigation
        </button>
      </aside>

      <main className="main">
        <header className="topbar">
          <div className="globalSearch">
            <Search size={18} />
            <input placeholder="Search CNIC, name, assets, or cases..." />
          </div>

          <div className="topActions">
            <Bell size={20} />
            <Settings size={20} />
            <div className="profile">
              <b>Senior Auditor</b>
              <small>Tax Integrity Div.</small>
            </div>
            <button className="ghostBtn" onClick={logout}>Logout</button>
          </div>
        </header>

        <section className="content">
          <Outlet />
        </section>

        <footer>
          <b>INTERNAL USE ONLY</b>
          <span></span>
          System Status: <b className="green">Operational</b>
          <span></span>
          Last Sync: Live
        </footer>
      </main>
    </div>
  );
}
